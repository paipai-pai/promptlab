# Public application URL used to construct email confirmation redirects.
# Use the exact deployed URL in production and do not include a path.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Supabase project settings from the project's Connect dialog.
# The publishable key is intended for browser use and is still constrained by Auth and RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Never add a service_role key or secret key to a NEXT_PUBLIC_* variable.
