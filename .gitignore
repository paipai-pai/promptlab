# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/.playwright/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (commit the documented example only)
.env*
!.env.example

# local authentication and test credentials
playwright/.auth/
**/storage-state.json

# local package-manager cache
/.npm-cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
